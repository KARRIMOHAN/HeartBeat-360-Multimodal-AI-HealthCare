# ─────────────────────────────────────────────────────────────
# HeartBeat 360 — Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and set your credentials:
# cp .env.example .env

# ── Hugging Face API Token ──
HF_API_TOKEN=your_hugging_face_token_here

# ── Hugging Face Model IDs ──
HF_TEXT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_VISION_MODEL=Salesforce/blip-image-captioning-base
HF_OCR_MODEL=microsoft/trocr-base-printed
HF_SPEECH_MODEL=openai/whisper-small

# NVIDIA Models from Hugging Face for Voice Assistant
HF_VOICE_SPEECH_MODEL=nvidia/canary-1b
HF_VOICE_REASONING_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Qwen Multimodal & Reasoning Models for Medical & Tablet Scanning
HF_QWEN_VL_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
HF_QWEN_TEXT_MODEL=Qwen/Qwen2.5-72B-Instruct

# ── Live Medical Web Search Providers (Optional: Tavily / Serper / Brave) ──
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Inference provider routing (auto, hf-inference, together, etc.)
HF_PROVIDER=auto

# ── Clinical Safety Thresholds ──
SAFETY_CONFIDENCE_THRESHOLD=0.7

# ── Database ──
DATABASE_URL=sqlite:///backend/app/db/heartbeat360.db

# ── Server ──
API_HOST=0.0.0.0
API_PORT=8000
